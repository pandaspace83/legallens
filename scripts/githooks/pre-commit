#!/usr/bin/env bash
# Blocks a commit that adds something that looks like a secret. Enable once per clone:
#   git config core.hooksPath scripts/githooks
# Needs gitleaks (brew install gitleaks). Without it the hook warns and lets the commit through; CI still scans.
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so this commit was not scanned (brew install gitleaks)." >&2
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
exec gitleaks protect --staged --config .gitleaks.toml --redact --no-banner
