# LegalLens backend settings. Copy to .env and edit; every value here is the default.

# LEGALLENS_ENV=dev                       # dev | test | prod
# LEGALLENS_DATA_DIR=                     # default: ~/Library/Application Support/LegalLens (never a cloud-synced folder)
# LEGALLENS_HOST=127.0.0.1                # stays on this machine (DEC-08)
# LEGALLENS_PORT=8000

# Sign-in: dev accepts any password and any 6-digit code; the two-step contract is the same as real mode.
# LEGALLENS_AUTH_MODE=dev
# LEGALLENS_DEV_USER_EMAIL=lawyer@legallens.local
# LEGALLENS_SESSION_IDLE_MINUTES=30
# LEGALLENS_SESSION_MAX_HOURS=12

# Uploads
# LEGALLENS_SCANNER=clamd                 # clamd | none (none = dev only; documents are marked "not scanned")
# LEGALLENS_CLAMD_SOCKET=/opt/homebrew/var/run/clamav/clamd.sock
# LEGALLENS_MAX_UPLOAD_MB=50
# LEGALLENS_MAX_PAGES=300

# Ingestion
# LEGALLENS_CONVERTER=docling             # docling | fast (PyMuPDF + python-docx + Tesseract, no layout model)
# LEGALLENS_DOCLING_ARTIFACTS=            # default: <data dir>/models/docling
# LEGALLENS_OCR_LANG=eng
# LEGALLENS_OCR_LOW_CONFIDENCE=0.80

# Models
# LEGALLENS_EMBEDDER=bge-m3              # bge-m3 | hash | ollama
# LEGALLENS_RERANKER=bge                  # bge | none
# LEGALLENS_MODELS_DIR=                   # default: <data dir>/models/hf
# LEGALLENS_MODEL_DEVICE=auto             # auto | mps | cuda | cpu
# LEGALLENS_K_PER_LEG=25
# LEGALLENS_K_FUSED=50
# LEGALLENS_RERANK_TOP_N=8
# LEGALLENS_EMBED_DIM=1024                # fixed when the database is created; must match the embedding model
# LEGALLENS_OLLAMA_URL=http://127.0.0.1:11434
# LEGALLENS_OLLAMA_EMBED_MODEL=bge-m3

# Orchestration and streaming
# LEGALLENS_ORCHESTRATOR=stub            # stub | local (a local model through Ollama; nothing leaves this machine)
# LEGALLENS_LLM_URL=http://127.0.0.1:11434
# LEGALLENS_LLM_REWRITE_MODEL=llama3.2:3b
# LEGALLENS_LLM_ANSWER_MODEL=qwen2.5:7b-instruct
# LEGALLENS_LLM_SUMMARY_MODEL=qwen2.5:7b-instruct
# LEGALLENS_LLM_DRAFT_MODEL=qwen2.5:7b-instruct
# LEGALLENS_LLM_CONTEXT_TOKENS=8192
# LEGALLENS_LLM_TIMEOUT_SECONDS=300
# LEGALLENS_STUB_TOKEN_DELAY_MS=25
# LEGALLENS_SSE_PING_SECONDS=15
# LEGALLENS_INPROCESS_WORKER=false        # `legallens dev` turns this on
