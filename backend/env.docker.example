# Copy to env.docker and edit. env.docker is never committed. No real secrets belong in this example.
# The image already sets LEGALLENS_DATA_DIR=/data, LEGALLENS_HOST=0.0.0.0 and LEGALLENS_PORT=8000.

LEGALLENS_ENV=dev
# Dev sign-in accepts any password and 6-digit code (never for real data). Keep comments on their own lines:
# docker's --env-file does not strip a comment after a value.
LEGALLENS_AUTH_MODE=dev

# No ClamAV socket exists in the container, so uploads are not scanned. Fine for synthetic documents only.
LEGALLENS_SCANNER=none

# Small and quick to try: no 4.5 GB model download, no layout models.
LEGALLENS_EMBEDDER=hash
LEGALLENS_RERANKER=none
LEGALLENS_CONVERTER=fast

# Stand-in answers need no model server. For the local models, run Ollama on the Mac and use:
LEGALLENS_ORCHESTRATOR=stub
# LEGALLENS_ORCHESTRATOR=local
# LEGALLENS_LLM_URL=http://host.docker.internal:11434

# Optional: LEGALLENS_DB_KEY=<64 hex characters> for an encrypted database (pass it as a secret, never bake it in).
