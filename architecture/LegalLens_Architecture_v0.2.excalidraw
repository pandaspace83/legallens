50, "version": 2, "versionNonce": 1947888593, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "b48"}, {"id": "te00359", "type": "text", "x": 5078, "y": 935.75, "width": 628, "height": 25, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00170", "roundness": null, "seed": 259888701, "version": 2, "versionNonce": 1106228671, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "SSE events  \u00b7  GET /runs/{run_id}/stream  (one per chat turn)", "originalText": "SSE events  \u00b7  GET /runs/{run_id}/stream  (one per chat turn)", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b49"}, {"id": "te00360", "type": "text", "x": 5078, "y": 973.75, "width": 780, "height": 210, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00170", "roundness": null, "seed": 1514946878, "version": 2, "versionNonce": 1583270321, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "id: 17                  sequence number; reconnect sends Last-Event-ID\nevent: run.started      {run_id, message_id}\nevent: intent           {intent: \"ask\", confidence: 0.93}\nevent: scope            {searching: \"Smith MSA v3 + Exhibits A-B\"}\nevent: status           {step: rewriting | searching | reranking | generating | verifying}\nevent: token            {delta: \"Either party may\"}\nevent: citation         {n: 1, citation_id, document, page: 12, para: \"4.2(a)\", verified: true}\nevent: answer_state     {state: found | partial | not_found}\nevent: job              {job_id, kind: summarize | draft}\nevent: error            {code, message}\nevent: done             {message_id, tokens_in, tokens_out, latency_ms}\n: ping                  heartbeat comment every 15 s", "originalText": "id: 17                  sequence number; reconnect sends Last-Event-ID\nevent: run.started      {run_id, message_id}\nevent: intent           {intent: \"ask\", confidence: 0.93}\nevent: scope            {searching: \"Smith MSA v3 + Exhibits A-B\"}\nevent: status           {step: rewriting | searching | reranking | generating | verifying}\nevent: token            {delta: \"Either party may\"}\nevent: citation         {n: 1, citation_id, document, page: 12, para: \"4.2(a)\", verified: true}\nevent: answer_state     {state: found | partial | not_found}\nevent: job              {job_id, kind: summarize | draft}\nevent: error            {code, message}\nevent: done             {message_id, tokens_in, tokens_out, latency_ms}\n: ping                  heartbeat comment every 15 s", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b4A"}, {"id": "li00361", "type": "line", "x": 6070, "y": 941.75, "width": 0, "height": 252, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00170", "roundness": null, "seed": 689366896, "version": 2, "versionNonce": 1393599967, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "points": [[0, 0], [0, 252]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "index": "b4B"}, {"id": "te00362", "type": "text", "x": 6090, "y": 935.75, "width": 346, "height": 25, "angle": 0, "strokeColor": "#3b5bdb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth"