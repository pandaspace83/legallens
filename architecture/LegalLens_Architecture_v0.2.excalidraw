": 3640, "y": 1110, "width": 1360, "height": 202.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00298"], "frameId": "fr00170", "roundness": {"type": 3}, "seed": 688317259, "version": 2, "versionNonce": 58466047, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "b3R"}, {"id": "te00300", "type": "text", "x": 3658, "y": 1124, "width": 202, "height": 25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00298"], "frameId": "fr00170", "roundness": null, "seed": 1348615620, "version": 2, "versionNonce": 421041265, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "Request conventions", "originalText": "Request conventions", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b3S"}, {"id": "te00301", "type": "text", "x": 3658, "y": 1161, "width": 889, "height": 127.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00298"], "frameId": "fr00170", "roundness": null, "seed": 851092049, "version": 2, "versionNonce": 297658143, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "JSON over HTTPS on 127.0.0.1 only. FastAPI also serves the React build: same origin, no CORS.\nSession: HttpOnly + SameSite=Strict cookie after password + TOTP. Idle timeout. CSRF header on writes.\nMatter scope: every route loads the matter and checks it belongs to the signed-in lawyer, or 403.\nLong work returns 202 + job_id. Progress arrives on /matters/{matter_id}/events.\nErrors use application/problem+json (RFC 9457). Lists use cursor pagination.\nPOST /messages takes an Idempotency-Key, so a double-click doesn't run a turn twice.", "originalText": "JSON over HTTPS on 127.0.0.1 only. FastAPI also serves the React build: same origin, no CORS.\nSession: HttpOnly + SameSite=Strict cookie after password + TOTP. Idle timeout. CSRF header on writes.\nMatter scope: every route loads the matter and checks it belongs to the signed-in lawyer, or 403.\nLong work returns 202 + job_id. Progress arrives on /matters/{matter_id}/events.\nErrors use application/problem+json (RFC 9457). Lists use cursor pagination.\nPOST /messages takes an Idempotency-Key, so a double-click doesn't run a turn twice.", "fontSize": 17, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b3T"}, {"id": "re00303", "type": "rectangle", "x": 5060, "y": 150, "width": 760, "height": 147, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00302"], "frameId": "fr00170", "roundness": {"type": 3}, "seed": 663261613, "version": 2, "versionNonce": 1590615633, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "b3U"}, {"id": "el00305", "type": "ellipse", "x": 5068, "y": 158, "width": 36, "height": 36, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#e03131", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00304"], "frameId": "fr00170", "roundness": {"type": 2}, "seed": 165661014, "version": 2, "versionNonce": 1624353599, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "b3V"}, {"id": "te00306", "type": "text", "x": 5079.5, "y": 164.75, "width": 13, "height": 22.5,