0, "groupIds": [], "frameId": "fr00828", "roundness": null, "seed": 478464029, "version": 2, "versionNonce": 20752305, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "points": [[0, 0], [0, 30]], "lastCommittedPoint": null, "startBinding": {"elementId": "re00922", "focus": 0, "gap": 5}, "endBinding": {"elementId": "re00927", "focus": 0, "gap": 5}, "startArrowhead": null, "endArrowhead": "triangle", "elbowed": false, "index": "bCw"}, {"id": "re00963", "type": "rectangle", "x": 620, "y": 6793, "width": 1000, "height": 337.5, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "#e3fafc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00962"], "frameId": "fr00828", "roundness": {"type": 3}, "seed": 602082933, "version": 2, "versionNonce": 1007134687, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "index": "bCx"}, {"id": "te00964", "type": "text", "x": 638, "y": 6807, "width": 417, "height": 25, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00962"], "frameId": "fr00828", "roundness": null, "seed": 2093185154, "version": 2, "versionNonce": 663652753, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "Hybrid search: both legs filtered by matter", "originalText": "Hybrid search: both legs filtered by matter", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bCy"}, {"id": "te00965", "type": "text", "x": 638, "y": 6844, "width": 616, "height": 262.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00962"], "frameId": "fr00828", "roundness": null, "seed": 1159630089, "version": 2, "versionNonce": 1168462847, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "-- dense leg (sqlite-vec): the partition key keeps KNN inside the matter\nSELECT rowid AS chunk_id, distance\nFROM chunks_vec\nWHERE embedding MATCH :query_vec AND k = 40\n  AND matter_id = :matter_id;\n\n-- sparse leg (FTS5): lower bm25() = better match\nSELECT c.id AS chunk_id, bm25(chunks_fts) AS score\nFROM chunks_fts JOIN chunks c ON c.id = chunks_fts.rowid\nWHERE chunks_fts MATCH :fts_query\n  AND c.matter_id = :matter_id\nORDER BY score LIMIT 40;\n\n-- 'this document' scope: add c.document_id IN (...) to the sparse leg;\n-- for the dense leg, fetch k = 200 and keep chunks in the scoped documents", "originalText": "-- dense leg (sqlite-vec): the partition key keeps KNN inside the matter\nSELECT rowid AS chunk_id, distance\nFROM chunks_vec\nWHERE embedding MATCH :query_vec AND k = 40\n  AND matter_id = :matter_id;\n\n-- sparse leg (FTS5): lower bm25() = better match\nSELECT c.id AS chunk_id, bm25(chunks_fts) AS score\nFROM chunks_fts JOIN chunks c ON c.id = chunks_fts.rowid\nWHERE chunks_fts MATCH :fts_query\n  AND c.matter_id = :matter_id\nORDER BY score LIMIT 40;\n\n-- 'this document' scope: add c.document_id IN (...) to the sparse leg;\n-- for the dense leg, fetch k = 200 and keep chunks in the scoped documents", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bCz"}, {"id": "re00967", "type": "rectangle", "x": 1700, "y": 6863, "width": 1000, "height": 285, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00966"], "frameId": "fr00828", "roundness": {"type": 3}, "seed": 856092054, "version": 2, "versionNonce": 1359556465, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "index": "bD0"}, {"id": "te00968", "type": "text", "x": 1718, "y": 6877, "width": 242, "height": 25, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00966"], "frameId": "fr00828", "roundness": null, "seed": 1338847847, "version": 2, "versionNonce": 49839135, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "Sidebar + memory queries", "originalText": "Sidebar + memory queries", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bD1"}, {"id": "te00969", "type": "text", "x": 1718, "y": 6914, "width": 378, "height": 210, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00966"], "frameId": "fr00828", "roundness": null, "seed": 462665144, "version": 2, "versionNonce": 603199825, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "-- sidebar: chat history for the open matter\nSELECT id, title, updated_at, pinned\nFROM conversations\nWHERE matter_id = :matter_id\nORDER BY pinned DESC, updated_at DESC\nLIMIT 30;   -- next page: cursor on updated_at\n\n-- memory for the router and the rewriter\nSELECT role, content FROM messages\nWHERE conversation_id = :cid\nORDER BY created_at DESC LIMIT 6;\n-- older turns live in conversations.summary", "originalText": "-- sidebar: chat history for the open matter\nSELECT id, title, updated_at, pinned\nFROM conversations\nWHERE matter_id = :matter_id\nORDER BY pinned DESC, updated_at DESC\nLIMIT 30;   -- next page: cursor on updated_at\n\n-- memory for the router and the rewriter\nSELECT role, content FROM messages\nWHERE conversation_id = :cid\nORDER BY created_at DESC LIMIT 6;\n-- older turns live in conversations.summary", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bD2"}, {"id": "re00971", "type": "rectangle", "x": 1700, "y": 7178, "width": 1000, "height": 197.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00970"], "frameId": "fr00828", "roundness": {"type": 3}, "seed": 889830451, "version": 2, "versionNonce": 1475452991, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "index": "bD3"}, {"id": "te00972", "type": "text", "x": 1718, "y": 7192, "width": 151, "height": 25, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00970"], "frameId": "fr00828", "roundness": null, "seed": 1413720328, "version": 2, "versionNonce": 296142641, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "Engine settings", "originalText": "Engine settings", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bD4"}, {"id": "te00973", "type": "text", "x": 1718, "y": 7229, "width": 491.232, "height": 122.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00970"], "frameId": "fr00828", "roundness": null, "seed": 322283927, "version": 3, "versionNonce": 1450262623, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "SQLite in WAL mode today; SQLCipher 4 (AES-256) planned for Slice 4\nPRAGMA journal_mode = WAL; foreign_keys = ON; busy_timeout = 5000\nWAL: readers never block the single writer\nSQLAlchemy 2 + Alembic migrations; sqlite-vec loaded as an extension\nScope guard adds WHERE matter_id = ? to every query (DEC-53)\nON DELETE CASCADE from matters and documents (DEC-58)\nNightly encrypted backup with a tested restore (DEC-61)", "originalText": "SQLite in WAL mode today; SQLCipher 4 (AES-256) planned for Slice 4\nPRAGMA journal_mode = WAL; foreign_keys = ON; busy_timeout = 5000\nWAL: readers never block the single writer\nSQLAlchemy 2 + Alembic migrations; sqlite-vec loaded as an extension\nScope guard adds WHERE matter_id = ? to every query (DEC-53)\nON DELETE CASCADE from matters and documents (DEC-58)\nNightly encrypted backup with a tested restore (DEC-61)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bD5"}, {"id": "nr00001", "type": "rectangle", "x": 2806, "y": 6992, "width": 560, "height": 330, "angle": 0, "strokeColor": "#c2410c", "backgroundColor": "#fff7ed", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "fr00828", "roundness": {"type": 3}, "seed": 896920395, "version": 2, "versionNonce": 291782143, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "a3"}, {"id": "nt00002", "type": "text", "x": 2826, "y": 7010, "width": 148.608, "height": 20.0, "angle": 0, "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00828", "roundness": null, "seed": 1814278692, "version": 2, "versionNonce": 531369144, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "ADDED IN THE BUILD", "originalText": "ADDED IN THE BUILD", "fontSize": 16, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bBF"}, {"id": "nt00003", "type": "text", "x": 2826, "y": 7050, "width": 303.408, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00831"], "frameId": "fr00828", "roundness": null, "seed": 1613673814, "version": 2, "versionNonce": 450938854, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "runs\nid \u00b7 matter_id \u00b7 conversation_id \u00b7 user_id\nstatus \u00b7 message ids \u00b7 cancel flag\n(owner + replay buffer of a chat turn)", "originalText": "runs\nid \u00b7 matter_id \u00b7 conversation_id \u00b7 user_id\nstatus \u00b7 message ids \u00b7 cancel flag\n(owner + replay buffer of a chat turn)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bBN"}, {"id": "nt00004", "type": "text", "x": 2826, "y": 7150, "width": 353.976, "height": 52.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00831"], "frameId": "fr00828", "roundness": null, "seed": 327737063, "version": 2, "versionNonce": 1732582746, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "matter_events\nid (= SSE id) \u00b7 matter_id \u00b7 kind \u00b7 payload\n(the worker's outbox; the matter stream tails it)", "originalText": "matter_events\nid (= SSE id) \u00b7 matter_id \u00b7 kind \u00b7 payload\n(the worker's outbox; the matter stream tails it)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bBN"}, {"id": "nt00005", "type": "text", "x": 2826, "y": 7235, "width": 353.976, "height": 52.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00831"], "frameId": "fr00828", "roundness": null, "seed": 793935960, "version": 2, "versionNonce": 692632934, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "index_meta   (migration 0003, 2026-10-13)\nkey 'embedding' = signature of the model that\nwrote the vectors; a mismatch skips the dense leg", "originalText": "index_meta   (migration 0003, 2026-10-13)\nkey 'embedding' = signature of the model that\nwrote the vectors; a mismatch skips the dense leg", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bBN"}, {"id": "nr00006", "type": "rectangle", "x": 4770, "y": 1238, "width": 1520, "height": 96, "angle": 0, "strokeColor": "#c2410c", "backgroundColor": "#fff7ed", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "fr00170", "roundness": {"type": 3}, "seed": 1765172226, "version": 2, "versionNonce": 291782143, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "a3"}, {"id": "nt00007", "type": "text", "x": 4790, "y": 1252, "width": 487.10400000000004, "height": 20.0, "angle": 0, "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00170", "roundness": null, "seed": 2145537668, "version": 2, "versionNonce": 791504237, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "AS BUILT (2026-10-14): 49 endpoints, 37 designed + 12 added", "originalText": "AS BUILT (2026-10-14): 49 endpoints, 37 designed + 12 added", "fontSize": 16, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bBF"}, {"id": "nt00008", "type": "text", "x": 4790, "y": 1278, "width": 917.448, "height": 52.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00831"], "frameId": "fr00170", "roundness": null, "seed": 1387332978, "version": 2, "versionNonce": 866625439, "isDeleted": false, "boundElements": [], "updated": 1791331688950, "link": null, "locked": false, "text": "Added: POST /auth/dev-session \u00b7 GET /documents/{id}/pages \u00b7 GET /documents/{id}/hidden-content \u00b7 POST /jobs/{id}/cancel\nGET /jobs/{id}/file \u00b7 GET /health \u00b7 GET /matters/{id}/summaries \u00b7 POST /summaries/{id}/export \u00b7 GET + POST /matters/{id}/drafts\nPOST /drafts/{id}/sections/{id}/propose \u00b7 POST /drafts/{id}/claims/{id}/propose", "originalText": "Added: POST /auth/dev-session \u00b7 GET /documents/{id}/pages \u00b7 GET /documents/{id}/hidden-content \u00b7 POST /jobs/{id}/cancel\nGET /jobs/{id}/file \u00b7 GET /health \u00b7 GET /matters/{id}/summaries \u00b7 POST /summaries/{id}/export \u00b7 GET + POST /matters/{id}/drafts\nPOST /drafts/{id}/sections/{id}/propose \u00b7 POST /drafts/{id}/claims/{id}/propose", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "bBN"}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#ffffff"}, "files": {}}