ft\", \"refine_draft\", \"clarify\"]\n    confidence: float                         # 0..1\n    target_document_ids: list[str] = []       # names in the message, resolved\n    summary_template: Literal[\"letter_demand\", \"pleading\", \"opinion\"] | None\n    audience: Literal[\"one_paragraph\", \"detailed\", \"plain_english\"] | None\n    draft_type: Literal[\"response_letter\", \"memo\"] | None\n    clarifying_question: str | None", "originalText": "class Intent(BaseModel):\n    intent: Literal[\"ask\", \"summarize\", \"draft\", \"refine_draft\", \"clarify\"]\n    confidence: float                         # 0..1\n    target_document_ids: list[str] = []       # names in the message, resolved\n    summary_template: Literal[\"letter_demand\", \"pleading\", \"opinion\"] | None\n    audience: Literal[\"one_paragraph\", \"detailed\", \"plain_english\"] | None\n    draft_type: Literal[\"response_letter\", \"memo\"] | None\n    clarifying_question: str | None", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6s"}, {"id": "re00558", "type": "rectangle", "x": 3660, "y": 3155, "width": 1020, "height": 237.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00557"], "frameId": "fr00538", "roundness": {"type": 3}, "seed": 800520576, "version": 2, "versionNonce": 638232671, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "b6t"}, {"id": "te00559", "type": "text", "x": 3678, "y": 3169, "width": 412.8, "height": 25.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00557"], "frameId": "fr00538", "roundness": null, "seed": 2073165185, "version": 3, "versionNonce": 328847633, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "LangChain wiring (v0.1 design, not used)", "originalText": "LangChain wiring (v0.1 design, not used)", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6u"}, {"id": "te00560", "type": "text", "x": 3678, "y": 3206, "width": 854, "height": 162.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00557"], "frameId": "fr00538", "roundness": null, "seed": 1012917968, "version": 2, "versionNonce": 1752450175, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "router = router_prompt | chat_model.with_structured_output(Intent)\n\nroute = RunnableBranch(\n    (lambda s: s[\"intent\"].intent == \"ask\",          ask_chain),         # streams\n    (lambda s: s[\"intent\"].intent == \"summarize\",    enqueue_summary),   # job\n    (lambda s: s[\"intent\"].intent == \"draft\",        enqueue_draft),     # job\n    (lambda s: s[\"intent\"].intent == \"refine_draft\", refine_chain),      # streams\n    clarify_chain,                                                       # default\n)\nturn = load_context | RunnablePassthrough.assign(intent=router) | gate | route | output_guard | persist_and_emit", "originalText": "router = router_prompt | chat_model.with_structured_output(Intent)\n\nroute = RunnableBranch(\n    (lambda s: s[\"intent\"].intent == \"ask\",          ask_chain),         # streams\n    (lambda s: s[\"intent\"].intent == \"summarize\",    enqueue_summary),   # job\n    (lambda s: s[\"intent\"].intent == \"draft\",        enqueue_draft),     # job\n    (lambda s: s[\"intent\"].intent == \"refine_draft\", refine_chain),      # streams\n    clarify_chain,                                                       # default\n)\nturn = load_context | RunnablePassthrough.assign(intent=router) | gate | route | output_guard | persist_and_emit", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6v"}, {"id": "re00561", "type": "rectangle", "x": 6890, "y": 2660, "width": 260, "height": 200, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": {"type": 3}, "seed": 1870379787, "version": 2, "versionNonce": 994019057, "isDeleted": false, "boundElements": [{"id": "te00562", "type": "text"}, {"id": "ar00565", "type": "arrow"}, {"id": "ar00587", "type": "arrow"}, {"id": "ar00610", "type": "arrow"}, {"id": "ar00633", "type": "arrow"}, {"id": "ar00653", "type": "arrow"}, {"id": "ar00664", "type": "arrow"}], "updated": 1791331688949, "link": null, "locked": false, "index": "b6w"}, {"id": "te00562", "type": "text", "x": 6908.544, "y": 2703.75, "width": 222.912, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": null, "seed": 1267410140, "version": 3, "versionNonce": 1066753183, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "Output guard\nrule-based: markers,\nliteral quotes, figures;\nfailures fall back to\nquoted passages", "originalText": "Output guard\nrule-based: markers,\nliteral quotes, figures;\nfailures fall back to\nquoted passages", "fontSize": 18, "fontFamily": 5, "textAlign": "center", "verticalAlign": "middle", "containerId": "re00561", "autoResize": true, "lineHeight": 1.25, "index": "b6x"}, {"id": "re00563", "type": "rectangle", "x": 6890, "y":