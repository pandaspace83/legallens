d", "roughness": 0, "opacity": 100, "groupIds": ["g00534"], "frameId": "fr00365", "roundness": null, "seed": 71693578, "version": 2, "versionNonce": 551712575, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "run in the background worker. The\nchat turn ends at once with a job card;\nprogress and the result arrive on\n/matters/{matter_id}/events.", "originalText": "run in the background worker. The\nchat turn ends at once with a job card;\nprogress and the result arrive on\n/matters/{matter_id}/events.", "fontSize": 17, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6b"}, {"id": "fr00538", "type": "frame", "x": 3600, "y": 2100, "width": 3600, "height": 1380, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 829374784, "version": 2, "versionNonce": 772988977, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "name": "4 \u00b7 Intent router and workflows", "index": "b6c"}, {"id": "te00539", "type": "text", "x": 3640, "y": 2128, "width": 1362.24, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": null, "seed": 2013105738, "version": 3, "versionNonce": 422524767, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "4 \u00b7 Orchestration: router and workflows (as built, own code)", "originalText": "4 \u00b7 Orchestration: router and workflows (as built, own code)", "fontSize": 44, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6d"}, {"id": "te00540", "type": "text", "x": 3642, "y": 2196, "width": 2043.3600000000001, "height": 25.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": null, "seed": 898717016, "version": 3, "versionNonce": 1040822801, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "The router picks the workflow from the prompt-bar mode or keywords. Ask and Refine stream inline; Summarize and Draft run as background jobs. The model is qwen2.5:14b locally; checks are rule-based.", "originalText": "The router picks the workflow from the prompt-bar mode or keywords. Ask and Refine stream inline; Summarize and Draft run as background jobs. The model is qwen2.5:14b locally; checks are rule-based.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6e"}, {"id": "re00542", "type": "rectangle", "x": 3660, "y": 2250, "width": 1020, "height": 206.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g00541"], "frameId": "fr00538", "roundness": {"type": 3}, "seed": 1562587307, "version": 2, "versionNonce": 1177482111, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "index": "b6f"}, {"id": "te00543", "type": "text", "x": 3678, "y": 2264, "width": 804.96, "height": 25.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00541"], "frameId": "fr00538", "roundness": null, "seed": 1749585227, "version": 3, "versionNonce": 789268465, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "Router examples (v0.1 design: few-shot prompt; the built router uses keywords)", "originalText": "Router examples (v0.1 design: few-shot prompt; the built router uses keywords)", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6g"}, {"id": "te00544", "type": "text", "x": 3678, "y": 2301, "width": 809, "height": 131.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g00541"], "frameId": "fr00538", "roundness": null, "seed": 1720443951, "version": 2, "versionNonce": 270674847, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "\"What notice do we need to end the MSA?\"         \u2192 ask\n\"Is this non-compete enforceable in California?\" \u2192 ask (answer flags outside law)\n\"Summarize the demand letter for the client\"     \u2192 summarize \u00b7 letter_demand \u00b7 plain_english\n\"Draft a reply rejecting claims 2 and 4\"         \u2192 draft \u00b7 response_letter\n\"Write a memo on whether the cap applies\"        \u2192 draft \u00b7 memo\n\"Make paragraph 3 firmer\"                        \u2192 refine_draft (a draft is open)\n\"Hi, what can you do?\"                           \u2192 clarify", "originalText": "\"What notice do we need to end the MSA?\"         \u2192 ask\n\"Is this non-compete enforceable in California?\" \u2192 ask (answer flags outside law)\n\"Summarize the demand letter for the client\"     \u2192 summarize \u00b7 letter_demand \u00b7 plain_english\n\"Draft a reply rejecting claims 2 and 4\"         \u2192 draft \u00b7 response_letter\n\"Write a memo on whether the cap applies\"        \u2192 draft \u00b7 memo\n\"Make paragraph 3 firmer\"                        \u2192 refine_draft (a draft is open)\n\"Hi, what can you do?\"                           \u2192 clarify", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b6h"}, {"id": "re00545", "type": "rectangle", "x": 3660, "y": 2660, "width": 300, "height": 170, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": {"type": 3}, "seed": 1868501112, "version": 2, "versionNonce": 455025105, "isDeleted": false, "boundElements": [{"id": "te00546", "type": "text"}, {"id": "ar00551", "type": "arrow"}], "updated": 1791331688949, "link": null, "locked": false, "index": "b6i"}, {"id": "te00546", "type": "text", "x": 3710, "y": 2700, "width": 200, "height": 90, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": null, "seed": 518622247, "version": 2, "versionNonce": 54091711, "isDeleted": false, "boundElements": [], "updated": 1791331688949, "link": null, "locked": false, "text": "Chat turn\nmessage \u00b7 scope \u00b7 mode\n+ last N turns\n+ matter profile", "originalText": "Chat turn\nmessage \u00b7 scope \u00b7 mode\n+ last N turns\n+ matter profile", "fontSize": 18, "fontFamily": 5, "textAlign": "center", "verticalAlign": "middle", "containerId": "re00545", "autoResize": true, "lineHeight": 1.25, "index": "b6j"}, {"id": "re00547", "type": "rectangle", "x": 4020, "y": 2645, "width": 360, "height": 200, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffe8cc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "fr00538", "roundness": {"type": 3}, "seed": 426422772, "